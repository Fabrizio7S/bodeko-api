# Copiar a .env.dev y completar solo en el equipo local. No publicar ese archivo.
# Si se usa Docker, POSTGRES_PASSWORD y DB_PASSWORD deben coincidir.
POSTGRES_DB=bodeko
POSTGRES_USER=bodeko
POSTGRES_PASSWORD=

DB_URL=jdbc:postgresql://localhost:5432/bodeko
DB_USERNAME=bodeko
DB_PASSWORD=

# Generar una clave aleatoria de al menos 32 bytes. No reutilizar la clave de otro entorno.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

FRONTEND_URL=http://localhost:3000

# Pasarela de pagos: culqi (por defecto) o mock.
# mock = pagos simulados dentro del backend, sin cuenta ni servicio externo (recomendado para la demo/despliegue académico).
#   Tokens: tkn_test_ok (aprobado), tkn_test_declined (rechazado). Con mock no se usan las variables CULQI_*.
PAYMENT_PROVIDER=culqi

# Clave ficticia del simulador local. Reemplazar solo en .env.dev al usar Culqi real.
CULQI_SECRET_KEY=
CULQI_API_URL=http://127.0.0.1:8199/v2

MAIL_PROVIDER=logging
MAIL_FROM=
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=

# Cloudflare R2 (almacenamiento de imágenes, API compatible con S3).
# R2 > Manage API tokens: crear un token con permiso "Object Read & Write" sobre el bucket.
# R2_ENDPOINT es opcional: si se deja vacío se usa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL: dominio público del bucket (propio o https://pub-xxxx.r2.dev), sin barra final.
# En la base de datos solo se guarda la ruta relativa (stores/<tienda>/products/<id>.webp).
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
